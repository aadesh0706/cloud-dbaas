# Production Environment Variables for Render
NODE_ENV=production
PORT=5000

# JWT Configuration
JWT_SECRET=your-super-secret-production-jwt-key-change-this-immediately

# Platform Database (Required - Use Render PostgreSQL or Supabase)
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=dbaas_platform
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# CORS Configuration
CORS_ORIGIN=https://dbaas-ten.vercel.app

# Redis (Optional - Use Redis Cloud free tier)
REDIS_URL=redis://your-redis-host:port

# External Database APIs (Optional - for creating user databases)
# Get these from respective providers for full DBaaS functionality
PLANETSCALE_API_TOKEN=your-planetscale-token
SUPABASE_API_KEY=your-supabase-key
MONGODB_ATLAS_API_KEY=your-atlas-key
REDIS_CLOUD_API_KEY=your-redis-cloud-key

# Monitoring (Optional)
PROMETHEUS_URL=https://your-prometheus-service
GRAFANA_URL=https://your-grafana-service
